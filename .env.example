# Gemini API key for AI slide generation
# Get yours at https://aistudio.google.com/apikey
# Copy this file to .env and paste your key:
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase (Optional: For scheduled tests, class rosters, and database storage)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Drive & Google Sheets Webhook (Optional: For 5 TB Drive handwritten sheet uploads & auto-updating spreadsheets)
VITE_GOOGLE_SCRIPT_URL=

