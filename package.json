{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "npm run sync-admin && npm run build-sitemap && npm run build-content && vite",
    "generate-visuals": "python3 scripts/generate-visual-assets.py",
    "build-content": "npm run generate-visuals && node scripts/build-content.mjs",
    "sync-admin": "node scripts/sync-admin.mjs",
    "build-sitemap": "node scripts/build-sitemap.mjs",
    "validate-content": "node scripts/validate-content.mjs",
    "check": "npm run build-content && tsc -b && npm run lint",
    "build": "npm run sync-admin && npm run build-sitemap && npm run build-content && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^9.0.1",
    "react-router": "^8.2.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "oxlint": "^1.73.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.4"
  }
}
